# Cloudflare Pages _headers
# Applies to all static assets served by Cloudflare Pages (no SSR Worker).

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Long-lived cache for all model files (content-addressed by filename).
# The .onnx file is ~23 MB; immutable tells browsers never to revalidate.
/models/*
  Cache-Control: public, max-age=31536000, immutable

# WASM binary: must be served as application/wasm for the browser
# to compile it with the streaming API (WebAssembly.compileStreaming).
/models/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# ONNX protobuf: application/octet-stream is the correct MIME type.
/models/*.onnx
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
